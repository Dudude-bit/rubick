{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/tsbuildinfo",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/ui/*"]
    },
    // Since TypeScript 6, every `@types` package is no longer pulled in.
    // Only `node` is needed explicitly; the rest arrive through imports or
    // the `vite/client` reference in `src/ui/vite-env.d.ts`.
    "types": ["node"]
  },
  "include": ["src/ui"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
