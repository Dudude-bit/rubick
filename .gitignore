# Rust
/target/
# A local `target-dir` override, so several worktrees share one build
# directory. It holds an absolute path from one machine.
/.cargo/

# Node
node_modules
ui/node_modules/

# Build outputs
/ui/dist/
/dist/
*.log

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Tauri
/src-tauri/target/
/src-tauri/.force_rebuild

# Test coverage
coverage/
*.lcov

# Temporary files
*.tmp
*.temp

.cursor/

artifacts/
__pycache__/

# Worktrees
.worktrees/
# What the Flatpak workflow writes, and writes at the repo root: its download
# step's `cd packaging/flatpak` dies with that step, so every later step runs
# from here. Reproducing the workflow locally otherwise leaves an ostree repo,
# a builder cache and a ~100 MB bundle one `git add -A` away from a commit.
builddir/
repo/
.flatpak-builder/
*.flatpak
ldd.txt
run.log
